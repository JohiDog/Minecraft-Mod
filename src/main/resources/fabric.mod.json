{
  "schemaVersion": 1,
  "id": "klassen",
  "version": "${version}",
  "name": "Klassen Framework",
  "description": "Rassen-, Klassen- und Skill-System mit Progression-Locks, X-Uebersicht (alle Rassen/Aufstiege) und JEI-Requirements. Basierend auf Origins/Apoli.",
  "authors": [
    "JohiDog"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.johidog.klassen.KlassenMod"
    ],
    "client": [
      "io.github.johidog.klassen.client.KlassenModClient"
    ]
  },
  "depends": {
    "java": ">=17",
    "fabricloader": ">=0.15.10",
    "minecraft": "1.20.2",
    "fabric-api": ">=0.91.6+1.20.2",
    "origins": ">=1.12.10",
    "apoli": ">=2.11.11"
  },
  "suggests": {
    "jei": "*"
  },
  "mixins": [
    "klassen.mixins.json"
  ]
}